<body>
  <div class="header">
  <div class="header_top">
    <p class="p_fliat">
      <a href="/SIC/web/govreport.po" target="_blank">政府网站工作年度报表</a>
    </p>
    <div id="addNewSearch">
      <div class="p_last" style="margin-right:0px;"><a href="/serve/wechat/wechat.html" target="_blank"><img
              src="/assets/images/weixin.png" id="weixin"></a></div>
    </div>
    <div id="ewm">
      <div class="arrows"><img src="/assets/images/ewm.png"></div>
      <div class="div">
        <div class="div_on"><img src="/assets/images/wechatserve.jpg" width="100" height="100">
          <p>服务号</p>
        </div>
        <!--     <div class="div_tw"><img src="/assets/images/wechatdy.jpg" width="100" height="100"><p>订阅号</p></div> -->
      </div>
    </div>
  </div>
</div>
<script>
    // 等待 DOM 加载完成
    document.addEventListener('DOMContentLoaded', function() {
        var weixin = document.getElementById('weixin');
        var ewm = document.getElementById('ewm');
        var timeoutId = null;
        
        if (weixin && ewm) {
            // 鼠标移入微信图标
            weixin.addEventListener('mouseenter', function() {
                // 清除之前的定时器
                if (timeoutId) {
                    clearTimeout(timeoutId);
                    timeoutId = null;
                }
                // 显示二维码（使用 slideDown 效果）
                slideDown(ewm);
            });
            
            // 鼠标移出微信图标
            weixin.addEventListener('mouseleave', function() {
                // 延迟隐藏，给用户时间移动到二维码区域
                timeoutId = setTimeout(function() {
                    slideUp(ewm);
                }, 100);
            });
            
            // 鼠标移入二维码区域
            ewm.addEventListener('mouseenter', function() {
                // 清除隐藏定时器，保持显示
                if (timeoutId) {
                    clearTimeout(timeoutId);
                    timeoutId = null;
                }
            });
            
            // 鼠标移出二维码区域
            ewm.addEventListener('mouseleave', function() {
                slideUp(ewm);
            });
        }
    });
    
    // 模拟 jQuery 的 slideDown 效果
    function slideDown(element) {
        element.style.overflow = 'hidden';
        element.style.display = 'block';
        element.style.height = '0';
        element.style.opacity = '0';
        
        var targetHeight = element.scrollHeight;
        var duration = 200; // 动画持续时间（毫秒）
        var startTime = null;
        
        function animate(currentTime) {
            if (!startTime) startTime = currentTime;
            var progress = currentTime - startTime;
            var percent = Math.min(progress / duration, 1);
            
            // 缓动函数（ease-out）
            var easePercent = 1 - Math.pow(1 - percent, 3);
            
            element.style.height = (targetHeight * easePercent) + 'px';
            element.style.opacity = easePercent;
            
            if (percent < 1) {
                requestAnimationFrame(animate);
            } else {
                element.style.height = 'auto';
                element.style.opacity = '1';
            }
        }
        
        requestAnimationFrame(animate);
    }
    
    // 模拟 jQuery 的 slideUp 效果
    function slideUp(element) {
        element.style.overflow = 'hidden';
        var startHeight = element.offsetHeight;
        element.style.height = startHeight + 'px';
        
        var duration = 200; // 动画持续时间（毫秒）
        var startTime = null;
        
        function animate(currentTime) {
            if (!startTime) startTime = currentTime;
            var progress = currentTime - startTime;
            var percent = Math.min(progress / duration, 1);
            
            // 缓动函数（ease-in）
            var easePercent = Math.pow(percent, 3);
            
            element.style.height = (startHeight * (1 - easePercent)) + 'px';
            element.style.opacity = 1 - easePercent;
            
            if (percent < 1) {
                requestAnimationFrame(animate);
            } else {
                element.style.display = 'none';
                element.style.height = '';
                element.style.opacity = '';
                element.style.overflow = '';
            }
        }
        
        requestAnimationFrame(animate);
    }
</script>
